DB_PATH=local.db
SERVER_ADDRESS=:8080
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=123456
TENANT_PASSWORD=123456
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false


# Object storage: Cloudflare R2 (S3-compatible) for uploaded files such as payment proofs.
# Fill these in the deployment environment; never commit real keys.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=neighbor-link-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
